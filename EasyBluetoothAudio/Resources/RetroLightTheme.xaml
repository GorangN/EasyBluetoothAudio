<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="RetroAppearance.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F3E2"/>
    <VisualBrush x:Key="WindowTextureBrush" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
        <VisualBrush.Visual>
            <Canvas Width="10" Height="10">
                <Path Data="{StaticResource RetroStripeGeometry}" Stroke="#07000000" StrokeThickness="3"/>
            </Canvas>
        </VisualBrush.Visual>
    </VisualBrush>

    <SolidColorBrush x:Key="RetroAccentBrush" Color="#B8A000"/>
    <DrawingBrush x:Key="SourceHeadingBackground" Viewbox="0,0,4,24" ViewboxUnits="Absolute"
                  Viewport="0,2,4,24" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="{StaticResource RetroAccentBrush}" Geometry="{StaticResource RetroHeadingAccentGeometry}"/>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <SolidColorBrush x:Key="TitleBarBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondarySurfaceBrush" Color="#EEEBD5"/>
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#E1E1E1"/>
    <SolidColorBrush x:Key="PressedSurfaceBrush" Color="#D2D2D2"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#616174"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#BEBEC8"/>
    <SolidColorBrush x:Key="SourceStatusBackground" Color="#08000000"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#666666"/>
    <SolidColorBrush x:Key="PrimaryActionBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="PrimaryActionTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryActionHoverBrush" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="ConnectedBrush" Color="#2E7D32"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#C62828"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#006B75"/>
    <SolidColorBrush x:Key="SourceIdleIndicatorBrush" Color="#C62828"/>
    <SolidColorBrush x:Key="SourceBusyIndicatorBrush" Color="#006B75"/>
    <SolidColorBrush x:Key="SourceStatusTextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SourceConnectedTextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SourceWarningTextBrush" Color="#1A1A1A"/>

    <SolidColorBrush x:Key="SourcePickerBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SourcePickerBorderBrush" Color="#B8A000"/>
    <SolidColorBrush x:Key="SourcePickerHoverBrush" Color="#F5F5F8"/>
    <SolidColorBrush x:Key="SourcePickerTextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SourcePickerIndicatorBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SourcePickerSelectionBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="DisconnectTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DisconnectHoverBrush" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="DisconnectPressedBrush" Color="#454545"/>

    <SolidColorBrush x:Key="RetroSectionHeadingBrush" Color="#776600"/>
    <SolidColorBrush x:Key="RetroSettingsCardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RetroSettingsCardBorderBrush" Color="#E8E8EE"/>
    <SolidColorBrush x:Key="SettingsSelectorBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SettingsSelectorHoverBrush" Color="#F0F0F5"/>
    <SolidColorBrush x:Key="SettingsSelectorBorderBrush" Color="#E8E8EE"/>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <FontFamily x:Key="InterfaceFont">Consolas</FontFamily>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="SmallControlCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="FocusCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="SourceFrameCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="SourcePickerCornerRadius">0</CornerRadius>
    <sys:Double x:Key="SourceHeadingFontSize">18</sys:Double>
    <sys:Double x:Key="SourcePickerFontSize">20</sys:Double>
    <Visibility x:Key="CurrentAppearanceVisibility">Collapsed</Visibility>
    <Visibility x:Key="RetroAppearanceVisibility">Visible</Visibility>
    <Thickness x:Key="PanelContentMargin">16,16,16,14</Thickness>
    <Thickness x:Key="SourceFramePadding">14,8</Thickness>
    <Thickness x:Key="SourceFrameBorderThickness">1</Thickness>
    <Thickness x:Key="SourcePickerBorderThickness">2</Thickness>
    <Thickness x:Key="SourcePickerPopupBorderThickness">2,0,2,2</Thickness>
    <Thickness x:Key="SourcePickerPressedBorderThickness">2</Thickness>
    <Thickness x:Key="SourcePickerPopupMargin">0</Thickness>
    <Thickness x:Key="ButtonSurfaceMargin">0</Thickness>
    <GridLength x:Key="SourceDetailHeight">*</GridLength>
    <sys:Double x:Key="SourcePickerHeight">35</sys:Double>
    <sys:Double x:Key="SourceActionHeight">31</sys:Double>
    <sys:Double x:Key="SourceActionFontSize">13</sys:Double>
    <sys:String x:Key="SourceConnectText">CONNECT</sys:String>
    <sys:String x:Key="SourceReconnectText">RECONNECT</sys:String>
    <sys:String x:Key="SourceDisconnectText">DISCONNECT</sys:String>
    <sys:String x:Key="SourceCancelText">CANCEL</sys:String>
    <sys:Int32 x:Key="SourceStatusRow">3</sys:Int32>
    <sys:Int32 x:Key="SourceActionsRow">1</sys:Int32>
    <GridLength x:Key="SourceActionGap">*</GridLength>
    <GridLength x:Key="SourceStatusBottomGap">0.5*</GridLength>
    <Thickness x:Key="SourceStatusPadding">8,0</Thickness>
    <sys:Double x:Key="SourceStatusHeight">20</sys:Double>
    <Thickness x:Key="SourceStatusTextMargin">0,0,8,0</Thickness>
    <sys:Double x:Key="SourceStatusDotSize">8</sys:Double>
    <CornerRadius x:Key="SourceStatusCornerRadius">2</CornerRadius>
    <Thickness x:Key="SourceHeadingPadding">14,2,0,0</Thickness>
    <sys:String x:Key="SourceHeadingText">AUDIO SINK</sys:String>
    <sys:String x:Key="SettingsHeadingText">SETTINGS</sys:String>
    <sys:String x:Key="SettingsAppearanceHeadingText">APPEARANCE</sys:String>
    <sys:String x:Key="SettingsStartupHeadingText">STARTUP</sys:String>
    <sys:String x:Key="SettingsNotificationsHeadingText">NOTIFICATIONS &amp; SOUND</sys:String>
    <sys:String x:Key="SettingsQualityHeadingText">BLUETOOTH QUALITY</sys:String>

    <RectangleGeometry x:Key="RetroHeadingAccentGeometry" Rect="0,0,4,24"/>
    <StreamGeometry x:Key="RetroStripeGeometry">M 0,10 L 10,0 M -2,2 L 2,-2 M 8,12 L 12,8</StreamGeometry>
    <DropShadowEffect x:Key="SourceFrameEffect" Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.07" Direction="270"/>
</ResourceDictionary>

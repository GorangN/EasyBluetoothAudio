<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="RetroAppearance.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#000000"/>
    <VisualBrush x:Key="WindowTextureBrush" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
        <VisualBrush.Visual>
            <Canvas Width="10" Height="10">
                <Path Data="{StaticResource RetroStripeGeometry}" Stroke="#11FFFFFF" StrokeThickness="3"/>
            </Canvas>
        </VisualBrush.Visual>
    </VisualBrush>

    <SolidColorBrush x:Key="RetroAccentBrush" Color="#CCCF00"/>
    <DrawingBrush x:Key="SourceHeadingBackground" Viewbox="0,0,4,24" ViewboxUnits="Absolute"
                  Viewport="0,2,4,24" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="{StaticResource RetroAccentBrush}" Geometry="{StaticResource RetroHeadingAccentGeometry}"/>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <SolidColorBrush x:Key="TitleBarBrush" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SecondarySurfaceBrush" Color="#101010"/>
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="PressedSurfaceBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#444444"/>
    <SolidColorBrush x:Key="SourceStatusBackground" Color="#11FFFFFF"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#7A7A7A"/>
    <SolidColorBrush x:Key="PrimaryActionBrush" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="PrimaryActionTextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="PrimaryActionHoverBrush" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ConnectedBrush" Color="#39FF14"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF3131"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#00FFFF"/>
    <SolidColorBrush x:Key="SourceIdleIndicatorBrush" Color="#FF3131"/>
    <SolidColorBrush x:Key="SourceBusyIndicatorBrush" Color="#00FFFF"/>
    <SolidColorBrush x:Key="SourceStatusTextBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="SourceConnectedTextBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="SourceWarningTextBrush" Color="#E0E0E0"/>

    <SolidColorBrush x:Key="SourcePickerBrush" Color="#CCCF00"/>
    <SolidColorBrush x:Key="SourcePickerBorderBrush" Color="#CCCF00"/>
    <SolidColorBrush x:Key="SourcePickerHoverBrush" Color="#B2B500"/>
    <SolidColorBrush x:Key="SourcePickerTextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="SourcePickerIndicatorBrush" Color="#000000"/>
    <SolidColorBrush x:Key="SourcePickerSelectionBrush" Color="#000000"/>
    <SolidColorBrush x:Key="DisconnectTextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="DisconnectHoverBrush" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="DisconnectPressedBrush" Color="#999999"/>

    <SolidColorBrush x:Key="RetroSectionHeadingBrush" Color="#CCCF00"/>
    <SolidColorBrush x:Key="RetroSettingsCardBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="RetroSettingsCardBorderBrush" Color="#333333"/>
    <SolidColorBrush x:Key="SettingsSelectorBrush" Color="#444444"/>
    <SolidColorBrush x:Key="SettingsSelectorHoverBrush" Color="#555555"/>
    <SolidColorBrush x:Key="SettingsSelectorBorderBrush" Color="Transparent"/>
</ResourceDictionary>

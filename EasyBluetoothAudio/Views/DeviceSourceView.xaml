<UserControl x:Class="EasyBluetoothAudio.Views.DeviceSourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:EasyBluetoothAudio.Behaviors">
    <StackPanel>
        <Grid MinHeight="48">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0">
                <Ellipse.Style><Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Fill" Value="{DynamicResource ConnectedBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding IsReconnecting}" Value="True"><Setter Property="Fill" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                    </Style.Triggers>
                </Style></Ellipse.Style>
            </Ellipse>
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                       Margin="0,8,12,8" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ConnectedBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding IsReconnecting}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                    </Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
            <Path Grid.Column="2" Data="M1 8v6 M7 4v14 M13 6v10 M19 1v20 M25 4v14 M31 7v8 M37 3v16 M43 6v10"
                  Stroke="{DynamicResource ConnectedBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  VerticalAlignment="Center" Margin="0,0,2,0" IsHitTestVisible="False"
                  Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
        <TextBlock Text="Turn on the source and check that Bluetooth is paired." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8">
            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsAvailable}" Value="False"/><Condition Binding="{Binding IsBusy}" Value="False"/><Condition Binding="{Binding IsConnected}" Value="False"/>
                </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
        </TextBlock>
        <Grid x:Name="SourceActions">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Content="Reconnect" Command="{Binding ReconnectCommand}" Margin="0,0,4,0" Style="{StaticResource PrimaryButtonStyle}"
                        FontSize="12" AutomationProperties.Name="{Binding Name, StringFormat=Reconnect {0}}"
                        Visibility="Collapsed" RenderTransformOrigin="1,0.5" behaviors:ActionTransition.IsShown="{Binding ShowReconnectActions}"/>
                <Button Command="{Binding DisconnectCommand}" Visibility="Collapsed" behaviors:ActionTransition.IsShown="{Binding ShowDisconnectAction}" FontSize="12">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                        <Setter Property="Content" Value="Disconnect"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Margin" Value="4,0,0,0"/>
                        <Setter Property="Background" Value="{DynamicResource TitleBarBrush}"/><Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="RenderTransformOrigin" Value="0,0.5"/><Setter Property="AutomationProperties.Name" Value="{Binding Name, StringFormat=Disconnect {0}}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowReconnectActions}" Value="False">
                                <Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="Margin" Value="0"/><Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Content" Value="Cancel"/><Setter Property="AutomationProperties.Name" Value="{Binding Name, StringFormat=Cancel connection to {0}}"/></DataTrigger>
                        </Style.Triggers>
                    </Style></Button.Style>
                </Button>
            </Grid>
            <Button Content="Connect" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButtonStyle}" FontSize="12"
                    AutomationProperties.Name="{Binding Name, StringFormat=Connect {0}}" Visibility="Collapsed"
                    RenderTransformOrigin="0.5,0.5" behaviors:ActionTransition.IsShown="{Binding ShowConnectAction}"/>
        </Grid>
        <TextBlock Text="{Binding ErrorText}" FontSize="12" Foreground="{DynamicResource ErrorBrush}" Margin="0,8,0,0"
                   Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsedConverter}}" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
</UserControl>

<UserControl x:Class="EasyBluetoothAudio.Views.DeviceSourceView" x:Name="SourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:EasyBluetoothAudio.Behaviors">
    <Grid UseLayoutRounding="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="{DynamicResource SourceActionGap}"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="{DynamicResource SourceActionGap}"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="{DynamicResource SourceStatusBottomGap}"/>
        </Grid.RowDefinitions>
        <Border x:Name="SourceStatusStrip" Grid.Row="{DynamicResource SourceStatusRow}" MinHeight="{DynamicResource SourceStatusHeight}"
                Background="{DynamicResource SourceStatusBackground}" Padding="{DynamicResource SourceStatusPadding}"
                CornerRadius="{DynamicResource SourceStatusCornerRadius}"
                UseLayoutRounding="{Binding UseLayoutRounding, ElementName=SourceView}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Ellipse Width="{DynamicResource SourceStatusDotSize}" Height="{DynamicResource SourceStatusDotSize}"
                         VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse.Style><Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{DynamicResource SourceIdleIndicatorBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Fill" Value="{DynamicResource SourceBusyIndicatorBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Fill" Value="{DynamicResource ConnectedBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsReconnecting}" Value="True"><Setter Property="Fill" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                        </Style.Triggers>
                    </Style></Ellipse.Style>
                </Ellipse>
                <TextBlock Grid.Column="1" Text="{Binding StatusText, FallbackValue='No source selected'}" FontSize="12"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="{DynamicResource SourceStatusTextMargin}"
                           AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Foreground" Value="{DynamicResource SourceStatusTextBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SourceConnectedTextBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsReconnecting}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SourceWarningTextBrush}"/></DataTrigger>
                        </Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
                <Path Grid.Column="2" Data="M1 8v6 M7 4v14 M13 6v10 M19 1v20 M25 4v14 M31 7v8 M37 3v16 M43 6v10"
                      Stroke="{DynamicResource ConnectedBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      VerticalAlignment="Center" Margin="0,0,2,0" IsHitTestVisible="False">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Visibility" Value="{DynamicResource CurrentAppearanceVisibility}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Grid>
        </Border>
        <Grid x:Name="SourceActions" Grid.Row="{DynamicResource SourceActionsRow}"
              UseLayoutRounding="{Binding UseLayoutRounding, ElementName=SourceView}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="SourceReconnectButton" Content="{DynamicResource SourceReconnectText}" Command="{Binding ReconnectCommand}"
                        Margin="0,0,4,0" Style="{StaticResource PrimaryButtonStyle}"
                        FontSize="{DynamicResource SourceActionFontSize}" MinHeight="{DynamicResource SourceActionHeight}"
                        AutomationProperties.Name="{Binding Name, StringFormat=Reconnect {0}}"
                        Visibility="Collapsed" RenderTransformOrigin="1,0.5"
                        behaviors:ActionTransition.IsShown="{Binding ShowReconnectActions, FallbackValue=False}"/>
                <Button x:Name="SourceDisconnectButton" Command="{Binding DisconnectCommand}" Visibility="Collapsed"
                        FontSize="{DynamicResource SourceActionFontSize}" MinHeight="{DynamicResource SourceActionHeight}"
                        behaviors:ActionTransition.IsShown="{Binding ShowDisconnectAction, FallbackValue=False}">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource DisconnectButtonStyle}">
                        <Setter Property="Content" Value="{DynamicResource SourceDisconnectText}"/>
                        <Setter Property="Grid.Column" Value="1"/><Setter Property="Margin" Value="4,0,0,0"/>
                        <Setter Property="RenderTransformOrigin" Value="0,0.5"/><Setter Property="AutomationProperties.Name" Value="{Binding Name, StringFormat=Disconnect {0}}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowReconnectActions}" Value="False">
                                <Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="Margin" Value="0"/><Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Content" Value="{DynamicResource SourceCancelText}"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name, StringFormat=Cancel connection to {0}}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style></Button.Style>
                </Button>
            </Grid>
            <Button x:Name="SourceConnectButton" Content="{DynamicResource SourceConnectText}" Command="{Binding ConnectCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" FontSize="{DynamicResource SourceActionFontSize}"
                    MinHeight="{DynamicResource SourceActionHeight}" AutomationProperties.Name="{Binding Name, StringFormat=Connect {0}}"
                    Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"
                    behaviors:ActionTransition.IsShown="{Binding ShowConnectAction, FallbackValue=False}"/>
        </Grid>
    </Grid>
</UserControl>

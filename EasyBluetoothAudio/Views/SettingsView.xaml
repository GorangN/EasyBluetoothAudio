<UserControl x:Class="EasyBluetoothAudio.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Settings" Style="{StaticResource PageHeadingStyle}"/><TextBlock Text="Preferences for this PC." FontSize="13" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"/></StackPanel>
        </Grid>
        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" Style="{StaticResource CustomScrollViewerStyle}">
            <StackPanel>
                <TextBlock Text="Appearance" Style="{StaticResource SectionHeadingStyle}"/>
                <Label Content="Theme" Target="{Binding ElementName=ThemeChoice}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="0,4"/>
                <ComboBox x:Name="ThemeChoice" Style="{StaticResource SettingsComboBoxStyle}" ItemsSource="{Binding SettingsViewModel.ThemeModes}" SelectedItem="{Binding SettingsViewModel.ThemeMode}" AutomationProperties.Name="Theme" Margin="0,0,0,24"/>

                <TextBlock Text="Startup" Style="{StaticResource SectionHeadingStyle}"/>
                <CheckBox Content="Start with Windows" IsChecked="{Binding SettingsViewModel.AutoStartOnStartup}" Style="{StaticResource SettingsCheckBoxStyle}"/>
                <CheckBox Content="Reconnect my sources on startup" IsChecked="{Binding SettingsViewModel.AutoConnect}" Style="{StaticResource SettingsCheckBoxStyle}"/>
                <TextBlock Text="Restores the sources you left connected. A source you disconnect stays disconnected." Style="{StaticResource SecondaryTextStyle}" FontSize="13" Margin="32,0,0,8"/>
                <CheckBox Content="Install updates on startup" IsChecked="{Binding SettingsViewModel.AutoUpdateOnStartup}" Style="{StaticResource SettingsCheckBoxStyle}" Margin="0,0,0,24"/>

                <TextBlock Text="Notifications and sound" Style="{StaticResource SectionHeadingStyle}"/>
                <CheckBox Content="Show connection notifications" IsChecked="{Binding SettingsViewModel.ShowNotifications}" Style="{StaticResource SettingsCheckBoxStyle}"/>
                <CheckBox Content="Play a sound when a source connects" IsChecked="{Binding SettingsViewModel.PlayConnectionSound}" Style="{StaticResource SettingsCheckBoxStyle}" Margin="0,0,0,24"/>

                <TextBlock Text="Bluetooth quality" Style="{StaticResource SectionHeadingStyle}"/>
                <CheckBox Content="Use a lower Bluetooth bitrate" IsChecked="{Binding SettingsViewModel.LowEndHardwareMode}" Style="{StaticResource SettingsCheckBoxStyle}"/>
                <TextBlock Text="May help when devices share a busy radio. Applies to this PC and reconnects active sources. Windows may request administrator access." Style="{StaticResource SecondaryTextStyle}" FontSize="13" Margin="32,0,0,8"/>
                <TextBlock Text="Applying Bluetooth quality…" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8" Visibility="{Binding SettingsViewModel.IsApplyingQualityChange, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.LiveSetting="Polite"/>
                <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,8" Visibility="{Binding SettingsViewModel.QualityApplyFeedback, Converter={StaticResource NullToCollapsedConverter}}">
                    <TextBlock Text="{Binding SettingsViewModel.QualityApplyFeedback}" FontSize="13" AutomationProperties.LiveSetting="Polite"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Preferences save when you leave settings." FontSize="13" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Grid.Column="1" Content="Close settings" Command="{Binding SettingsViewModel.CloseCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="112"/>
        </Grid>
    </Grid>
</UserControl>

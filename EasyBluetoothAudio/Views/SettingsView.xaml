<UserControl x:Class="EasyBluetoothAudio.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Tag" Value="{DynamicResource RetroAppearanceVisibility}"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="{x:Static Visibility.Visible}">
                    <Setter Property="Background" Value="{DynamicResource RetroSettingsCardBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource RetroSettingsCardBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="6"/>
                    <Setter Property="Padding" Value="11,8"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.07" Direction="270"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource PageHeadingStyle}">
            <Setter Property="Tag" Value="{DynamicResource RetroAppearanceVisibility}"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="{x:Static Visibility.Visible}">
                    <Setter Property="Background" Value="{DynamicResource SourceHeadingBackground}"/>
                    <Setter Property="Padding" Value="{DynamicResource SourceHeadingPadding}"/>
                    <Setter Property="FontSize" Value="{DynamicResource SourceHeadingFontSize}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Height" Value="28"/>
                    <Setter Property="LineHeight" Value="24"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsCardHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeadingStyle}">
            <Setter Property="Tag" Value="{DynamicResource RetroAppearanceVisibility}"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="{x:Static Visibility.Visible}">
                    <Setter Property="Foreground" Value="{DynamicResource RetroSectionHeadingBrush}"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsThemeChoiceStyle" TargetType="ComboBox" BasedOn="{StaticResource SettingsComboBoxStyle}">
            <Setter Property="Margin" Value="0,0,0,24"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="{x:Static Visibility.Visible}">
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="FontSize" Value="13"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsLastToggleStyle" TargetType="CheckBox" BasedOn="{StaticResource SettingsCheckBoxStyle}">
            <Setter Property="Margin" Value="0,0,0,24"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="{x:Static Visibility.Visible}">
                    <Setter Property="Margin" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource SettingsHeadingText}" Style="{StaticResource SettingsHeadingStyle}"/>
                <TextBlock Text="Preferences for this PC." FontSize="13" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"
                           Visibility="{DynamicResource CurrentAppearanceVisibility}"/>
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" Style="{StaticResource CustomScrollViewerStyle}">
            <StackPanel>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SettingsAppearanceHeadingText}" Style="{StaticResource SettingsCardHeadingStyle}"/>
                        <Label Content="Theme" Target="{Binding ElementName=ThemeChoice}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="0,4"/>
                        <ComboBox x:Name="ThemeChoice" Style="{StaticResource SettingsThemeChoiceStyle}" ItemsSource="{Binding SettingsViewModel.ThemeModes}"
                                  SelectedValuePath="Key" SelectedValue="{Binding SettingsViewModel.ThemeMode}" DisplayMemberPath="Value"
                                  AutomationProperties.Name="Theme"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SettingsStartupHeadingText}" Style="{StaticResource SettingsCardHeadingStyle}"/>
                        <CheckBox Content="Start with Windows" IsChecked="{Binding SettingsViewModel.AutoStartOnStartup}" Style="{StaticResource SettingsCheckBoxStyle}"/>
                        <CheckBox Content="Reconnect my sources on startup" IsChecked="{Binding SettingsViewModel.AutoConnect}" Style="{StaticResource SettingsCheckBoxStyle}"/>
                        <TextBlock Text="Restores the sources you left connected. A source you disconnect stays disconnected." Style="{StaticResource SecondaryTextStyle}" FontSize="13" Margin="32,0,0,8"/>
                        <CheckBox Content="Install updates on startup" IsChecked="{Binding SettingsViewModel.AutoUpdateOnStartup}" Style="{StaticResource SettingsLastToggleStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SettingsNotificationsHeadingText}" Style="{StaticResource SettingsCardHeadingStyle}"/>
                        <CheckBox Content="Show connection notifications" IsChecked="{Binding SettingsViewModel.ShowNotifications}" Style="{StaticResource SettingsCheckBoxStyle}"/>
                        <CheckBox Content="Play a sound when a source connects" IsChecked="{Binding SettingsViewModel.PlayConnectionSound}" Style="{StaticResource SettingsLastToggleStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SettingsQualityHeadingText}" Style="{StaticResource SettingsCardHeadingStyle}"/>
                        <CheckBox Content="Use a lower Bluetooth bitrate" IsChecked="{Binding SettingsViewModel.LowEndHardwareMode}" Style="{StaticResource SettingsCheckBoxStyle}"/>
                        <TextBlock Text="May help when devices share a busy radio. Applies to this PC and reconnects active sources. Windows may request administrator access." Style="{StaticResource SecondaryTextStyle}" FontSize="13" Margin="32,0,0,8"/>
                        <TextBlock Text="Applying Bluetooth quality…" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8" Visibility="{Binding SettingsViewModel.IsApplyingQualityChange, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.LiveSetting="Polite"/>
                        <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="12" Margin="0,8,0,8" Visibility="{Binding SettingsViewModel.QualityApplyFeedback, Converter={StaticResource NullToCollapsedConverter}}">
                            <TextBlock Text="{Binding SettingsViewModel.QualityApplyFeedback}" FontSize="13" AutomationProperties.LiveSetting="Polite"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Preferences save when you leave settings." FontSize="13" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Grid.Column="1" Content="Close settings" Command="{Binding SettingsViewModel.CloseCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="112"/>
        </Grid>
    </Grid>
</UserControl>

<Window x:Class="EasyBluetoothAudio.Views.MainWindow" x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:views="clr-namespace:EasyBluetoothAudio.Views"
        xmlns:behaviors="clr-namespace:EasyBluetoothAudio.Behaviors"
        Title="EasyBluetoothAudio" Width="386" Height="278" MinWidth="320" MinHeight="236"
        ResizeMode="CanResize" ShowInTaskbar="False" Visibility="Hidden" WindowStartupLocation="Manual"
        WindowStyle="None" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource InterfaceFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        behaviors:SettingsFocus.IsEnabled="True" behaviors:SettingsFocus.IsSettingsOpen="{Binding IsSettingsOpen}"
        Icon="/EasyBluetoothAudio;component/Assets/EasyBluetoothAudio.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.InputBindings><KeyBinding Key="Escape" Command="{Binding CloseOrHideCommand}"/></Window.InputBindings>
    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <tb:TaskbarIcon x:Name="TrayIcon" IconSource="/EasyBluetoothAudio;component/Assets/EasyBluetoothAudio.ico" ToolTipText="Easy Bluetooth Audio"
                            DataContext="{Binding DataContext, ElementName=RootWindow}" LeftClickCommand="{Binding OpenCommand}" DoubleClickCommand="{Binding OpenCommand}">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="OpenTrayMenuItem" Header="Open"/>
                        <MenuItem x:Name="DevicesTrayMenuItem" Header="Audio sources"/>
                        <MenuItem x:Name="ReconnectTrayMenuItem" Header="Reconnect" Visibility="Collapsed"/>
                        <MenuItem x:Name="DisconnectAllTrayMenuItem" Header="Disconnect all"/>
                        <Separator/><MenuItem x:Name="ExitTrayMenuItem" Header="Exit"/>
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
            <Grid Margin="23,20,23,18">
                <views:BluetoothConfigView behaviors:PageTransition.IsEnabled="True" Visibility="{Binding IsSettingsOpen, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                <views:SettingsView x:Name="SettingsPage" behaviors:PageTransition.IsEnabled="True" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource IconButtonStyle}" Width="28" MinWidth="28" Height="28" MinHeight="28" Padding="1"
                            Command="{Binding Updater.InstallUpdateCommand}" ToolTip="Install available update" AutomationProperties.Name="Install available update"
                            Visibility="{Binding Updater.UpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" WindowChrome.IsHitTestVisibleInChrome="True">
                        <ContentControl Content="{StaticResource TablerDownload}" Style="{StaticResource TablerIconStyle}"/>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Width="28" MinWidth="28" Height="28" MinHeight="28" Padding="1" Margin="0,0,4,0"
                            Command="{Binding RefreshDevicesCommand}" ToolTip="Refresh audio sources" AutomationProperties.Name="Refresh audio sources" WindowChrome.IsHitTestVisibleInChrome="True">
                        <ContentControl Content="{StaticResource TablerRefresh}" Style="{StaticResource TablerIconStyle}"/>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButtonStyle}" Width="28" MinWidth="28" Height="28" MinHeight="28" Padding="1"
                            Command="{Binding OpenSettingsCommand}" ToolTip="{Binding SettingsActionLabel}" AutomationProperties.Name="{Binding SettingsActionLabel}" WindowChrome.IsHitTestVisibleInChrome="True">
                        <ContentControl Content="{StaticResource TablerSettings}" Style="{StaticResource TablerIconStyle}"/>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Width="28" MinWidth="28" Height="28" MinHeight="28" Padding="1" Margin="4,0,0,0"
                            Command="{Binding CloseOrHideCommand}" ToolTip="{Binding CloseActionLabel}" AutomationProperties.Name="{Binding CloseActionLabel}" WindowChrome.IsHitTestVisibleInChrome="True">
                        <ContentControl Content="{StaticResource TablerClose}" Style="{StaticResource TablerIconStyle}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

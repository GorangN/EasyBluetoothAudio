---
import '@fontsource-variable/chivo/wght.css';
import '../styles/global.css';
import AudioPreview from '../components/AudioPreview';
import Features from '../components/Features';
import { ShimmerButton } from '../components/magicui/shimmer-button';
import { Bluetooth, ArrowDownToLine, ArrowUpRight, Check, Monitor, Code2 } from 'lucide-react';
import { product, questions } from '../data/product';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = 'EasyBluetoothAudio | Free Bluetooth Audio for Windows';
const description = 'Play your phone’s music and podcasts through your Windows PC speakers. Download EasyBluetoothAudio, a free, open-source Bluetooth audio receiver for Windows.';
const schema = {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication',
  name: product.name, description, url: product.canonical,
  applicationCategory: 'MultimediaApplication', operatingSystem: 'Windows 10 (2004+) / Windows 11',
  downloadUrl: product.download, license: `${product.repository}/blob/main/LICENSE`,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171a17" />
    <meta name="description" content={description} />
    <link rel="canonical" href={product.canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={product.canonical} />
    <meta property="og:site_name" content={product.name} />
    <meta property="og:image" content={`${product.canonical}social-preview.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="EasyBluetoothAudio. Your phone. Your PC speakers. Free Bluetooth audio for Windows." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${product.canonical}social-preview.png`} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <noscript><style>.motion-toggle,.output-switch{display:none!important}.signal-bars i{animation:none!important}</style></noscript>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header frame">
      <a class="wordmark" href={`${base}/`} aria-label="EasyBluetoothAudio home"><span class="brand-icon"><Bluetooth size={23} aria-hidden="true" /></span><span>EasyBluetooth<span class="wordmark-audio">Audio</span></span></a>
      <nav aria-label="Main navigation"><a href="#how-it-works">How it works</a><a href="#questions">Questions</a><a class="github-nav" href={product.repository}><Code2 size={18} aria-hidden="true" /><span>GitHub</span><ArrowUpRight size={14} aria-hidden="true" /></a></nav>
      <a class="header-download" href={product.download}>Download free <ArrowDownToLine size={16} aria-hidden="true" /></a>
    </header>
    <main id="main">
      <section class="hero frame" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1 id="hero-title">Your phone.<br />Your PC speakers.</h1>
          <div class="hero-intro"><p>Play your phone’s audio through your PC. A free Bluetooth receiver for Windows that keeps your music, podcasts, and controls right where you like them.</p>
            <ShimmerButton href={product.download} className="download-button"><ArrowDownToLine size={20} aria-hidden="true" />Download for Windows</ShimmerButton>
            <p class="download-note">Free x64 installer · .NET runtime included</p>
            <p class="compatibility">Windows 10 (2004+) & 11 · Bluetooth required</p>
          </div>
        </div>
        <AudioPreview client:visible />
        <div class="hero-proof"><span><Check size={16} aria-hidden="true" /> No account needed</span><span><Check size={16} aria-hidden="true" /> No extra audio drivers</span><a href={`${product.repository}/blob/main/LICENSE`}><Code2 size={17} aria-hidden="true" /> Free & open source <ArrowUpRight size={13} aria-hidden="true" /></a></div>
      </section>
      <section class="features frame section-space" aria-labelledby="features-title">
        <div class="section-heading"><h2 id="features-title">Keep the playlist.<br />Use the good speakers.</h2><p>Your favorite apps are already on your phone. Your favorite place to listen is at your desk. Bring the two together.</p></div>
        <Features />
      </section>
      <section id="how-it-works" class="setup section-space" aria-labelledby="setup-title">
        <div class="frame setup-layout"><div class="setup-intro"><h2 id="setup-title">Pair once.<br />Press play.</h2><p>A phone, a Bluetooth-enabled Windows PC, and whatever you want to listen to.</p><a class="text-link" href={product.download}><ArrowDownToLine size={18} aria-hidden="true" />Download for Windows</a><p class="setup-note">The .NET runtime is included in the installer.</p></div>
          <ol class="setup-steps">
            <li><span class="step-number" aria-hidden="true">1</span><div><h3>Install on your PC</h3><p>Download and run <span class="filename">EasyBluetoothAudioSetup.exe</span>.</p></div><ArrowDownToLine size={25} aria-hidden="true" /></li>
            <li><span class="step-number" aria-hidden="true">2</span><div><h3>Pair your phone</h3><p>Use Windows Bluetooth settings to pair your phone with your PC.</p></div><Bluetooth size={25} aria-hidden="true" /></li>
            <li><span class="step-number" aria-hidden="true">3</span><div><h3>Connect. Then play.</h3><p>Open EasyBluetoothAudio, select your phone, and click <strong>Connect</strong>. Start playback on your phone.</p></div><Monitor size={25} aria-hidden="true" /></li>
          </ol>
        </div>
      </section>
      <section class="open-source frame section-space" aria-labelledby="open-title">
        <div class="source-mark" aria-hidden="true"><Code2 size={88} strokeWidth={1.25} /><span>Made to be open.</span></div>
        <div class="source-copy"><h2 id="open-title">Free software.<br />Nothing to sign up for.</h2><p>EasyBluetoothAudio is free software under the MIT license, with no subscription or trial period. Its source code, releases, and issue discussions are available on GitHub.</p><div class="source-links"><a class="text-link" href={product.repository}>View source on GitHub</a><a class="text-link" href={product.releases}>Read release notes</a></div><p class="community-proof">14 GitHub stars · 3 community forks <span>As of October 22, 2026</span></p></div>
      </section>
      <section id="questions" class="faq frame section-space" aria-labelledby="questions-title"><div class="faq-intro"><h2 id="questions-title">Before you<br />press play.</h2><p>A few things worth knowing.</p><a class="text-link" href={`${product.repository}/issues`}>Get help on GitHub <ArrowUpRight size={18} aria-hidden="true" /></a></div><div class="faq-list">{questions.map(({ question, answer }) => <details><summary>{question}<span class="faq-plus" aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
      <section class="final-cta section-space" aria-labelledby="download-title"><div class="frame final-layout"><div><h2 id="download-title">Your next listen,<br />through your PC.</h2><p>Download EasyBluetoothAudio and connect your paired phone.</p></div><div><ShimmerButton href={product.download} background="var(--accent-ink)" className="download-button download-dark"><ArrowDownToLine size={20} aria-hidden="true" />Download for Windows</ShimmerButton><p class="download-note">Free x64 installer · .NET runtime included</p><p class="compatibility">Windows 10 (2004+) & 11 · x64 · Bluetooth required</p></div></div></section>
    </main>
    <footer class="site-footer frame"><a class="wordmark" href={`${base}/`}><Bluetooth size={23} aria-hidden="true" /><span>EasyBluetoothAudio</span></a><p>A little less switching. A little more listening.</p><nav aria-label="Footer navigation"><a href={product.repository}>Source code</a><a href={`${product.repository}/blob/main/LICENSE`}>MIT license</a><a href={`${product.repository}/issues`}>Support</a></nav></footer>
  </body>
</html>
